name: "gpt_generator"
backend: "python"
max_batch_size: 1  # Autoregressive models typically batch=1 for latency

input [
  {
    name: "condition_embeddings"
    data_type: TYPE_FP16
    dims: [ -1, 1536 ]  # [seq_len, embed_dim]
  },
  {
    name: "uncond_embeddings"
    data_type: TYPE_FP16
    dims: [ -1, 1536 ]
  },
  {
    name: "guidance_scale"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "top_p"
    data_type: TYPE_FP32
    dims: [ 1 ]
    optional: true
  },
  {
    name: "max_tokens"
    data_type: TYPE_INT32
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "token_ids"
    data_type: TYPE_INT32
    dims: [ -1 ]  # [num_tokens] - typically 1024
  }
]

# No dynamic batching for autoregressive model - we want low latency
# Each request runs to completion before the next
instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# Model parameters
parameters: {
  key: "CUBE3D_PATH"
  value: { string_value: "/models/cube3d" }
}

parameters: {
  key: "GPT_CONFIG_PATH"
  value: { string_value: "/models/cube3d/cube3d/configs/open_model_v0.5.yaml" }
}

parameters: {
  key: "GPT_CHECKPOINT_PATH"
  value: { string_value: "/models/weights/gpt.safetensors" }
}

parameters: {
  key: "SHAPE_CHECKPOINT_PATH"
  value: { string_value: "/models/weights/shape.safetensors" }
}

parameters: {
  key: "USE_KV_CACHE"
  value: { string_value: "true" }
}

parameters: {
  key: "DEFAULT_MAX_TOKENS"
  value: { string_value: "1024" }
}
